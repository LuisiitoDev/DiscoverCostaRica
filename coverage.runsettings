<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage scope: production code only. Used locally and in CI (ci.yml). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[DiscoverCostaRica.*]*</Include>
          <!-- Test code, the test harness and the Aspire orchestrator are not production logic. -->
          <Exclude>[DiscoverCostaRica.*Tests]*,[DiscoverCostaRica.Testing]*,[DiscoverCostaRica.AppHost]*</Exclude>
          <!-- EF Core migrations are generated by `dotnet ef migrations add`. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <!-- Not CompilerGeneratedAttribute: that would also drop async state machines, i.e. the body of every async method. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
